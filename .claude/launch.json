{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "recipe-site (production build)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "recipe-site", "run", "start", "--", "-p", "3002"],
      "port": 3002
    },
    {
      "name": "recipe-site (dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "recipe-site", "run", "dev"],
      "port": 3002
    },
    {
      "name": "recipe-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "recipe-portal", "run", "start"],
      "port": 4200
    }
  ]
}
